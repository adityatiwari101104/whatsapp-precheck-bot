PORT=3000

# Provider mode: meta | twilio
WHATSAPP_PROVIDER=meta

# Display name prefix shown in every bot message
BOT_DISPLAY_NAME=CSC Sahayak AI

# Common app URL
APP_BASE_URL=http://localhost:3000

# Local JSON store path for sessions and generated precheck records
DATA_DIR=./data

# Website popup WhatsApp launch configuration
WHATSAPP_LAUNCH_NUMBER=14155238886
WHATSAPP_LAUNCH_TEXT=join your-sandbox-code
WHATSAPP_IS_SANDBOX=true

# Optional auth for CSC lookup APIs (/citizen-report/*)
CSC_API_BEARER_TOKEN=

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_TOKEN=change_me_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=change_me_twilio_account_sid
TWILIO_AUTH_TOKEN=change_me_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
